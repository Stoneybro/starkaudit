# =============================================================================
# StarkAudit — Environment Variables
# Copy this file to:
#   - .env.local (for scripts/ and packages/audit-sdk)
#   - apps/web/.env.local (for the Next.js dashboard)
# Never commit actual values. Keep secrets out of git.
# =============================================================================

# -----------------------------------------------------------------------------
# STARKNET NETWORK
# Start on Sepolia, switch to SN_MAIN only after all stages pass on testnet.
# -----------------------------------------------------------------------------

# "SN_SEPOLIA" for testnet | "SN_MAIN" for mainnet
NEXT_PUBLIC_CHAIN_ID=SN_SEPOLIA

# Alchemy (or other) RPC URL — you already have mainnet key in apps/web/.env.local
# Get a Sepolia key at https://dashboard.alchemy.com → New App → Starknet Sepolia
NEXT_PUBLIC_STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_ALCHEMY_KEY
# For scripts that run server-side (not prefixed with NEXT_PUBLIC_)
STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_ALCHEMY_KEY

# -----------------------------------------------------------------------------
# POOL ADDRESSES (do not change — these are the live pool deployments)
# -----------------------------------------------------------------------------

# Sepolia pool (use this during development)
NEXT_PUBLIC_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
# Mainnet pool (only for final demo, Stage 8)
# NEXT_PUBLIC_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Same values for backend scripts
POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# -----------------------------------------------------------------------------
# BUSINESS BACKEND WALLET (SDK key-holder — never the user's wallet)
# This is the account that holds the viewing key and signs private txs.
# Create a dedicated Sepolia account in Argent/Braavos for testing.
# WARNING: This is a backend secret — never expose in NEXT_PUBLIC_ vars.
# -----------------------------------------------------------------------------

# Starknet account address (0x...)
ACCOUNT_ADDRESS=0x_YOUR_SEPOLIA_ACCOUNT_ADDRESS

# Starknet account private key (0x...)
ACCOUNT_PRIVATE_KEY=0x_YOUR_SEPOLIA_PRIVATE_KEY

# STRK20 viewing key — this is a BigInt (decimal string), NOT a 0x hex string.
# Derive it by signing: signMessage("SN_SEPOLIA:POOL_ADDRESS") then fold % CURVE.n
# The SDK README and strk20-by-example.org/sdk/getting-started explain the exact steps.
VIEWING_KEY=YOUR_VIEWING_KEY_AS_DECIMAL_BIGINT

# -----------------------------------------------------------------------------
# PROVING SERVICE — SDK backend only (NOT needed for the Wallet API dashboard)
# The dashboard (apps/web) uses Ready/Xverse wallets which handle proving internally.
# The audit-sdk backend (scripts/, packages/audit-sdk) needs this to generate
# private transfer proofs server-side.
# → Ping @starkience or the STRK20 Telegram (t.me/sncorestars) for the Sepolia URL.
# -----------------------------------------------------------------------------

PROVING_SERVICE_URL=https://YOUR_PROVING_SERVICE_URL

# -----------------------------------------------------------------------------
# INDEXER / DISCOVERY SERVICE
# Used by the SDK to discover your notes and channels.
# → Ask for this alongside the proving service URL from @starkience.
# -----------------------------------------------------------------------------

INDEXER_URL=https://YOUR_INDEXER_URL

# -----------------------------------------------------------------------------
# DEPLOYED CONTRACT ADDRESSES (fill in after Stage 4 deploy)
# -----------------------------------------------------------------------------

# AuditRegistry contract address — empty until you deploy in Stage 4
NEXT_PUBLIC_AUDIT_REGISTRY=
# Same for backend scripts
AUDIT_REGISTRY_ADDRESS=

# PayrollAnonymizer contract address — empty until Stage 6 deploy
NEXT_PUBLIC_PAYROLL_ANONYMIZER=
PAYROLL_ANONYMIZER_ADDRESS=

# -----------------------------------------------------------------------------
# AUDIT PARAMETERS (business-side, used in build_witness.ts)
# These are set by the business and shared out-of-band with the auditor.
# -----------------------------------------------------------------------------

# Threshold in u128 (STRK uses 18 decimals — 1 STRK = 1000000000000000000)
# Example: 1 STRK threshold
AUDIT_THRESHOLD=1000000000000000000

# Duplicate detection window in seconds (e.g. 604800 = 7 days)
DUPLICATE_WINDOW_SECONDS=604800

# -----------------------------------------------------------------------------
# DASHBOARD (Next.js — NEXT_PUBLIC_ vars only, no secrets here)
# -----------------------------------------------------------------------------

# Demo URLs (fill in after Stage 7 deploy)
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
